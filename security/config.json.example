{
    "_comment": "Configuration template for Multi-Factor Behavioral Drift Continuous Security. Copy to config.json or let setup auto-generate it.",
    "email": {
        "enabled": false,
        "smtp_server": "smtp.gmail.com",
        "smtp_port": 587,

# ==============================================================================
# Environment Configuration Template for Multi-Factor Behavioral Drift Security
# Copy to .env for custom local machine settings (optional - safe defaults are built-in)
# ==============================================================================

# Cyber-Ops Web Dashboard Server Settings
HOST=0.0.0.0
PORT=8000

# Hardware Camera Configuration (0 = default integrated webcam, 1 = external USB webcam)
WEBCAM_DEVICE_INDEX=0

# Offline AI / LLM Threat Analysis Engine (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Security Lockout Master Bypass Password
MASTER_BYPASS_PASSWORD=admin

# Test and Automation Mode (set to 1 to disable GUI overlays during headless testing)
HEADLESS_TEST=0

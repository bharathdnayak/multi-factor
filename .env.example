# ==============================================================================
# Multi-Factor Behavioral Drift Continuous Security - Environment Configuration
# Copy this template to .env on your machine:
#   copy .env.example .env (Windows CMD)
#   cp .env.example .env   (Bash / PowerShell)
# Safe fallback defaults are built-in for all fields.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cyber-Ops Web Dashboard & REST Server
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Hardware Webcam & Privacy / Consent Policy
# 0 = Default integrated laptop webcam, 1 = External USB webcam
# ENABLE_WEBCAM_CAPTURE: 1 = Capture optical frame during Tier 3 confirmed breaches
# with administrative authorization/consent; 0 = Disable optical capture (strict privacy mode).
# ------------------------------------------------------------------------------
WEBCAM_DEVICE_INDEX=0
ENABLE_WEBCAM_CAPTURE=1

# ------------------------------------------------------------------------------
# 3. Offline AI / LLM Threat Analysis Engine (Ollama - Local Inference)
# Note: Ollama provides local on-device inference; it does NOT constitute an air-gapped system.
# Recommended models:
#   - qwen3.5:4b      (Default, balanced, rich reasoning, ~3.3 GB)
#   - qwen2.5:3b      (Fast, lightweight, ~1.9 GB)
#   - qwen2.5:1.5b    (Ultra-fast, lowest memory, ~1.0 GB)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=60

# ------------------------------------------------------------------------------
# 4. Security Lockout & Emergency Recovery Credentials
# Fresh installs leave this blank to strictly require cryptographic 6-digit session
# OTPs dispatched during confirmed breaches.
# To optionally set a non-shared recovery key for emergency owner unlock, configure
# a unique secret phrase (minimum 8 characters; trivial keys like admin/123456 are blocked).
# Legacy alias MASTER_BYPASS_PASSWORD is also honored if set.
# ------------------------------------------------------------------------------
EMERGENCY_RECOVERY_KEY=

# ------------------------------------------------------------------------------
# 5. Deception Sandbox Synthetic User Configuration
# Configurable Windows username rendered across the Honeypot VFS and Decoy Desktop.
# Defaults to WorkstationUser if unset.
# ------------------------------------------------------------------------------
SYNTHETIC_USERNAME=WorkstationUser

# ------------------------------------------------------------------------------
# 6. Automation & Test Mode
# 0 = Normal interactive production mode (renders PyQt6 desktop overlays)
# 1 = Headless test mode (suppresses modal dialogs for automated test suites)
# ------------------------------------------------------------------------------
HEADLESS_TEST=0

# ------------------------------------------------------------------------------
# 7. Multi-Factor Alert Notifications - Email (Optional)
# Dispatches 6-digit session OTP and silent webcam intruder photo on intrusion.
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_smtp_app_password
ALERT_EMAIL=owner_email@gmail.com

# ------------------------------------------------------------------------------
# 8. Multi-Factor Alert Notifications - Telegram (Optional)
# Dispatches real-time breach alerts with intruder evidence directly to Telegram.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

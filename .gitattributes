# Preserve Windows CRLF line endings for batch and PowerShell launchers
*.bat text eol=crlf
*.ps1 text eol=crlf

# Standardize Python, Web, Markdown, and JSON/YAML sources
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
